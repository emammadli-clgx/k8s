#!/bin/bash

#===============================================================================
# CONFIGURATION FILE
# Common configuration for all Kubernetes setup phases
#===============================================================================

# Kubernetes and component versions
export KUBERNETES_VERSION="v1.28.4"
export ETCD_VERSION="v3.5.10"
export CNI_VERSION="v1.3.0"
export CONTAINERD_VERSION="1.7.8"
export RUNC_VERSION="v1.1.9"
export CRICTL_VERSION="v1.28.0"

# Network configuration - Fixed CIDR conflicts
export CLUSTER_CIDR="10.32.0.0/12"   # Pod network CIDR
export SERVICE_CIDR="10.96.0.0/12"   # Service network CIDR (non-overlapping)
export KUBERNETES_SERVICE_IP="10.96.0.1"  # First IP in service CIDR
export CLUSTER_DNS_IP="10.96.0.10"   # DNS service IP

# Cluster configuration
export CLUSTER_NAME="kubernetes-the-hard-way"
export REGION="us-west-2"
export AVAILABILITY_ZONE="us-west-2c"

# Node configuration with fixed IP addresses
export MASTER_1_IP="192.168.56.10"
export MASTER_2_IP="192.168.56.11"
export WORKER_1_IP="192.168.56.20"
export WORKER_2_IP="192.168.56.21"
export LOADBALANCER_IP="192.168.56.30"

# Dynamic arrays for compatibility (aliases)
export WORKERS=("worker-1" "worker-2")
export MASTERS=("master-1" "master-2")
export WORKER_NODES=("worker-1" "worker-2")  # Compatibility alias
export MASTER_NODES=("master-1" "master-2")  # Compatibility alias

# Instance name arrays
export CONTROLLERS=("master-1" "master-2")
export WORKERS_LIST=("worker-1" "worker-2")

# SSH configuration
export SSH_USER="vagrant"
export SSH_KEY_PATH="/mnt/c/my_repos/k8s/vagrant/.vagrant/machines"

# Installation paths
export BIN_PATH="/usr/local/bin"
export CONFIG_PATH="/var/lib"
export SYSTEMD_PATH="/etc/systemd/system"

# Working directories (local)
export CERT_DIR="./certs"
export CONFIG_DIR="./configs"

# Certificate configuration
export CERT_PATH="/var/lib/kubernetes"
export ETCD_CERT_PATH="/etc/etcd"

# API Server configuration
export KUBERNETES_PUBLIC_ADDRESS="${LOADBALANCER_IP}"
export KUBERNETES_INTERNAL_ADDRESS="${MASTER_1_IP}"

# Function to display configuration summary
show_config() {
    echo "=== Configuration Summary ==="
    echo "Kubernetes Version: ${KUBERNETES_VERSION}"
    echo "etcd Version: ${ETCD_VERSION}"
    echo "Pod CIDR: ${CLUSTER_CIDR}"
    echo "Service CIDR: ${SERVICE_CIDR}"
    echo "Master Nodes: ${MASTERS[*]}"
    echo "Worker Nodes: ${WORKERS[*]}"
    echo "Load Balancer: ${LOADBALANCER_IP}"
    echo "============================="
}
