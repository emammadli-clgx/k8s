#!/bin/bash

#===============================================================================
# CONFIGURATION FILE
# Common configuration for all Kubernetes setup phases
#===============================================================================

# Kubernetes and component versions
export KUBERNETES_VERSION="v1.28.4"
export ETCD_VERSION="v3.5.10"

# Network Configuration - MODERNIZED FOR COMPATIBILITY
export CLUSTER_CIDR="10.32.0.0/12"        # Pod network CIDR (Weave Net compatible)
export SERVICE_CIDR="10.96.0.0/12"        # Service network CIDR (non-overlapping with cluster CIDR)
export CLUSTER_DNS="10.96.0.10"           # DNS service IP (within service CIDR)
export KUBERNETES_SERVICE_IP="10.96.0.1"  # Kubernetes API service IP
export LOADBALANCER_ADDRESS="192.168.5.30" # HAProxy load balancer IP

# Node Configuration
export MASTER_NODES=(master-1 master-2)
export MASTER_IPS=(192.168.5.11 192.168.5.12)
export WORKER_NODES=(worker-1 worker-2)  
export WORKER_IPS=(192.168.5.21 192.168.5.22)

# Alternative variable names for compatibility
export MASTERS=("${MASTER_NODES[@]}")
export WORKERS=("${WORKER_NODES[@]}")

# Working directories (relative to script location)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CERT_DIR="${SCRIPT_DIR}/certs"
export CONFIG_DIR="${SCRIPT_DIR}/configs"

# Create directories if they don't exist
mkdir -p "${CERT_DIR}" "${CONFIG_DIR}" 2>/dev/null || true

# Logging configuration
export LOG_LEVEL="INFO"  # DEBUG, INFO, WARN, ERROR

# Security settings
export ENABLE_AUDIT_LOGS="true"
export ENABLE_ENCRYPTION="true"

# Feature flags
export USE_WEAVE_NET="true"     # Use Weave Net CNI instead of manual routing
export SKIP_TLS_BOOTSTRAPPING="true"  # Use pre-generated certs (Hard Way approach)

echo "Configuration loaded:"
echo "  Kubernetes Version: ${KUBERNETES_VERSION}"
echo "  etcd Version: ${ETCD_VERSION}"
echo "  Cluster CIDR: ${CLUSTER_CIDR}"
echo "  Service CIDR: ${SERVICE_CIDR}"
echo "  Load Balancer: ${LOADBALANCER_ADDRESS}"
echo "  Certificates: ${CERT_DIR}"
echo "  Configs: ${CONFIG_DIR}"
